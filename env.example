# env.example
# Copy to .env and fill in. Never commit .env.
# Secrets convention: store simple string secrets directly as values
# here; for structured credential files (e.g. a JSON service key with a
# multi-line private key), store the file outside version control and put
# only its path here.

# Path to your CLMS service-key JSON (issued from your CLMS profile).
# Required only to download CORINE Land Cover. Never commit the key.
CLMS_SERVICE_KEY_PATH=

# WEkEO account credentials (free registration at https://www.wekeo.eu).
# Required only to download Copernicus HR-VPP.
WEKEO_USERNAME=
WEKEO_PASSWORD=

# Your Google Earth Engine Cloud project ID. Required only to download the
# GEE-sourced layers (AlphaEarth). Authenticate once with `earthengine authenticate`.
EE_PROJECT=
